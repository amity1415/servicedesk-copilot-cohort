# Copy this file to .env and adjust. .env is ignored by Git; never commit it.
# Every value below is a local development default, not a real secret.

COPILOT_ENV=dev
COPILOT_LOG_LEVEL=INFO
# console for humans, json for services
COPILOT_LOG_FORMAT=console
COPILOT_DATA_DIR=data

# Matches docker-compose.yml (used from session 10)
COPILOT_DATABASE_URL=postgresql://copilot:copilot_dev_only@127.0.0.1:5432/copilot
COPILOT_ANSWER_MODE=extractive

# Trainer-provided ticketing mock (used from session 17)
COPILOT_TICKETING_BASE_URL=http://localhost:8081
COPILOT_TICKETING_API_KEY=dev-ticketing-key

# Model access: fill these in session 4
COPILOT_LLM_PROVIDER=
COPILOT_LLM_MODEL=
COPILOT_LLM_API_KEY=
COPILOT_REQUEST_TIMEOUT_S=30
