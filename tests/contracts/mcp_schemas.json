{
  "assets_db": {
    "check_licences": {
      "properties": {
        "app_id": {
          "title": "App Id",
          "type": "string"
        }
      },
      "required": [
        "app_id"
      ],
      "title": "check_licencesArguments",
      "type": "object"
    },
    "check_service_status": {
      "properties": {},
      "title": "check_service_statusArguments",
      "type": "object"
    },
    "get_assets": {
      "properties": {
        "employee_id": {
          "title": "Employee Id",
          "type": "string"
        }
      },
      "required": [
        "employee_id"
      ],
      "title": "get_assetsArguments",
      "type": "object"
    },
    "get_employee": {
      "properties": {},
      "title": "get_employeeArguments",
      "type": "object"
    },
    "get_software_catalogue": {
      "properties": {},
      "title": "get_software_catalogueArguments",
      "type": "object"
    }
  },
  "documents": {
    "search_kb": {
      "properties": {
        "os_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os Name"
        },
        "query": {
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "search_kbArguments",
      "type": "object"
    }
  },
  "ticketing": {
    "create_ticket": {
      "$defs": {
        "TicketDraft": {
          "additionalProperties": false,
          "properties": {
            "asset": {
              "pattern": "^(?:LH-[LP]-[0-9]{5}|unknown|not applicable)$",
              "title": "Asset",
              "type": "string"
            },
            "assignment_group": {
              "enum": [
                "Service Desk L1",
                "Identity & Access",
                "Network Operations",
                "Workplace Engineering",
                "Messaging & Collaboration",
                "Software Packaging",
                "Security Operations",
                "Onboarding Team"
              ],
              "title": "Assignment Group",
              "type": "string"
            },
            "category": {
              "enum": [
                "Access & Identity",
                "Network & VPN",
                "Email & Collaboration",
                "Hardware & Devices",
                "Software",
                "Security",
                "Onboarding & Offboarding",
                "General Enquiry"
              ],
              "title": "Category",
              "type": "string"
            },
            "priority": {
              "enum": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "title": "Priority",
              "type": "string"
            },
            "steps_tried": {
              "items": {
                "type": "string"
              },
              "title": "Steps Tried",
              "type": "array"
            },
            "summary": {
              "maxLength": 160,
              "minLength": 3,
              "title": "Summary",
              "type": "string"
            }
          },
          "required": [
            "category",
            "priority",
            "summary",
            "steps_tried",
            "asset",
            "assignment_group"
          ],
          "title": "TicketDraft",
          "type": "object"
        }
      },
      "properties": {
        "draft": {
          "$ref": "#/$defs/TicketDraft"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "draft",
        "idempotency_key"
      ],
      "title": "create_ticketArguments",
      "type": "object"
    },
    "decide_access": {
      "properties": {
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "decision"
      ],
      "title": "decide_accessArguments",
      "type": "object"
    },
    "fulfil_access": {
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "integer"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "fulfil_accessArguments",
      "type": "object"
    },
    "onboard": {
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "start_date": {
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "start_date"
      ],
      "title": "onboardArguments",
      "type": "object"
    },
    "request_access": {
      "properties": {
        "app_id": {
          "title": "App Id",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "idempotency_key"
      ],
      "title": "request_accessArguments",
      "type": "object"
    }
  }
}
